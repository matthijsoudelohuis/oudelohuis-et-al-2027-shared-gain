# Byte-compiled / optimized / DLL files
__pycache__/
__pycache__
*.py[cod]
*.pyc
*.pyo

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Data (repo-root data/ only; sharedgain/data/ is tracked)
/data/

# 2_pipeline/<script>/: one folder per script in 1_scripts/, fully regenerable by re-running it.
# Commit only the png figures and csv tables under out/; everything in store/ (model fits,
# datasets, caches) and all other file types (pdf, npz, pkl, ...) stay local.
2_pipeline/**
!2_pipeline/*/
!2_pipeline/*/out/
!2_pipeline/*/out/**/
!2_pipeline/*/out/**/*.png
!2_pipeline/*/out/**/*.csv